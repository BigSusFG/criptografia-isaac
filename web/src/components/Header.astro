---
import { Download, KeyRound, Sparkles } from "lucide-react";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<header class="sticky top-0 z-50 border-b border-stone-200/60 bg-[#f8f6f0]/80 backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 md:px-8">
    <!-- Brand Avatar & Logo -->
    <a href={`${base}#hero`} class="group flex items-center gap-3.5" aria-label="Ir al inicio - Isaac Montoya">
      <div class="relative grid size-10 place-items-center rounded-2xl bg-gradient-to-tr from-pink-200 via-purple-200 to-amber-100 shadow-[0_4px_14px_rgba(244,114,182,0.2)] border border-white/80 transition group-hover:scale-105">
        <Sparkles size={18} className="text-pink-600 transition group-hover:rotate-12" />
        <span class="absolute -bottom-0.5 -right-0.5 size-2.5 rounded-full bg-emerald-400 border-2 border-white"></span>
      </div>
      <div>
        <span class="block font-semibold text-sm tracking-tight text-stone-900 group-hover:text-pink-600 transition">
          Isaac Montoya
        </span>
        <span class="block font-mono text-[10px] uppercase tracking-wider text-stone-500">
          ESCOM · IPN · Cripto
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav aria-label="Navegación principal" class="hidden items-center gap-1.5 font-medium text-xs text-stone-600 lg:flex">
      <a href={`${base}#hero`} class="px-3.5 py-1.5 rounded-full hover:bg-stone-200/50 hover:text-stone-900 transition">Inicio</a>
      <a href={`${base}#formacion`} class="px-3.5 py-1.5 rounded-full hover:bg-stone-200/50 hover:text-stone-900 transition">Formación</a>
      <a href={`${base}#hobbies`} class="px-3.5 py-1.5 rounded-full hover:bg-stone-200/50 hover:text-stone-900 transition">Hobbies</a>
      <a href={`${base}#criptografia`} class="px-3.5 py-1.5 rounded-full hover:bg-stone-200/50 hover:text-stone-900 transition">Criptografía</a>
      <a href={`${base}#practicas`} class="px-3.5 py-1.5 rounded-full hover:bg-stone-200/50 hover:text-stone-900 transition">Prácticas</a>
    </nav>

    <!-- Call to Actions -->
    <div class="flex items-center gap-2.5">
      <!-- "Mi Llave Pública" as a cute visual button / link -->
      <a
        href={`${base}#mi-llave-publica`}
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-purple-200/70 bg-purple-50/80 px-3.5 py-1.5 text-xs font-medium text-purple-800 shadow-sm transition hover:bg-purple-100/80 hover:border-purple-300"
      >
        <KeyRound size={13} className="text-purple-600" />
        <span>Mi Llave Pública</span>
      </a>

      <!-- Download CV Button -->
      <a
        href={`${base}cv.pdf`}
        download="CV_Isaac_Montoya_ESCOM.pdf"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-pink-500 to-rose-500 px-4 py-1.5 text-xs font-semibold text-white shadow-[0_4px_16px_rgba(244,63,94,0.3)] transition hover:from-pink-600 hover:to-rose-600 hover:shadow-[0_6px_20px_rgba(244,63,94,0.4)]"
      >
        <Download size={13} />
        <span>CV PDF</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="grid size-9 place-items-center rounded-xl border border-stone-200 bg-white/80 text-stone-700 shadow-sm transition hover:bg-white lg:hidden"
        aria-label="Abrir menú"
      >
        <svg id="menu-icon-bars" class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
        <svg id="menu-icon-close" class="hidden size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden border-b border-stone-200/80 bg-[#f8f6f0]/95 px-5 py-6 backdrop-blur-2xl lg:hidden">
    <nav class="flex flex-col gap-3 font-medium text-sm text-stone-700">
      <a href={`${base}#hero`} class="mobile-link flex items-center justify-between py-2 transition hover:text-pink-600">
        <span>Inicio / Presentación</span>
        <span class="font-mono text-xs text-stone-400">00</span>
      </a>
      <a href={`${base}#formacion`} class="mobile-link flex items-center justify-between py-2 transition hover:text-pink-600">
        <span>Formación Académica</span>
        <span class="font-mono text-xs text-stone-400">01</span>
      </a>
      <a href={`${base}#hobbies`} class="mobile-link flex items-center justify-between py-2 transition hover:text-pink-600">
        <span>Hobbies & Galería</span>
        <span class="font-mono text-xs text-stone-400">02</span>
      </a>
      <a href={`${base}#criptografia`} class="mobile-link flex items-center justify-between py-2 transition hover:text-pink-600">
        <span>Acerca de Criptografía</span>
        <span class="font-mono text-xs text-stone-400">03</span>
      </a>
      <a href={`${base}#mi-llave-publica`} class="mobile-link flex items-center justify-between py-2 transition hover:text-pink-600">
        <span>Mi Llave Pública</span>
        <span class="font-mono text-xs text-stone-400">04</span>
      </a>
      <a href={`${base}#practicas`} class="mobile-link flex items-center justify-between py-2 transition hover:text-pink-600">
        <span>Mis Prácticas</span>
        <span class="font-mono text-xs text-stone-400">05</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconBars = document.getElementById("menu-icon-bars");
  const iconClose = document.getElementById("menu-icon-close");
  const links = document.querySelectorAll(".mobile-link");

  if (menuBtn && menu && iconBars && iconClose) {
    menuBtn.addEventListener("click", () => {
      const isExpanded = !menu.classList.contains("hidden");
      if (isExpanded) {
        menu.classList.add("hidden");
        iconBars.classList.remove("hidden");
        iconClose.classList.add("hidden");
      } else {
        menu.classList.remove("hidden");
        iconBars.classList.add("hidden");
        iconClose.classList.remove("hidden");
      }
    });

    links.forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        iconBars.classList.remove("hidden");
        iconClose.classList.add("hidden");
      });
    });
  }
</script>
