---
import { KeyRound } from "lucide-react";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<header class="absolute inset-x-0 top-0 z-40 border-b border-orange-100/10 bg-[#0a0908]/78 backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 md:px-8">
    <a href={base} class="flex items-center gap-3" aria-label="Ir al inicio">
      <span class="grid size-9 place-items-center rounded-full border border-orange-300/30 bg-orange-300/10 text-orange-300">
        <KeyRound size={16} />
      </span>
      <span class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-stone-200">IMR / Crypto</span>
    </a>

    <nav aria-label="Navegación principal" class="flex items-center gap-5 font-mono text-[11px] uppercase tracking-[0.14em] text-stone-500 sm:gap-8">
      <a href={`${base}#practicas`} class="transition hover:text-orange-300">Prácticas</a>
      <a href={`${base}#arquitectura`} class="hidden transition hover:text-orange-300 sm:block">Arquitectura</a>
    </nav>
  </div>
</header>
