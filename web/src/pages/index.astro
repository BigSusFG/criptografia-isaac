---
import {
  ArrowRight,
  Award,
  Binary,
  BookOpen,
  Check,
  CheckCircle2,
  CircleDot,
  Compass,
  Copy,
  Download,
  ExternalLink,
  FileText,
  Fingerprint,
  GraduationCap,
  KeyRound,
  LockKeyhole,
  Mail,
  Mountain,
  Music,
  ShieldCheck,
  Snowflake,
  Sparkles,
  Terminal,
} from "lucide-react";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const cipherLines = [
  "7A 4F E1 09 C3 8D 2A F0",
  "2D B8 61 FF 0A C4 72 E9",
  "93 1C D4 72 BE 01 5B 3D",
  "08 EA 35 A7 19 F2 88 BC",
  "F6 40 8B 2E C1 39 0E 6A",
];

const studentInfo = {
  name: "Isaac Emilio Montoya Rodriguez",
  shortName: "Isaac Montoya",
  degree: "Ingeniería en Sistemas Computacionales",
  school: "Escuela Superior de Cómputo (ESCOM)",
  institution: "Instituto Politécnico Nacional (IPN)",
  course: "Criptografía",
  professor: "M. en C. Nidia A. Cortez Duarte",
  semester: "7° Semestre · Ciclo 2026",
  email: "emontoyar1400@alumno.ipn.mx",
  github: "https://github.com/BigSusFG",
  linkedin: "https://www.linkedin.com/in/isaac-montoya-rodriguez",
};

const hobbies = [
  {
    id: "mountain",
    title: "Senderismo Glaciar & Cumbres",
    category: "Expedición & Resistencia",
    badge: "Alta Montaña",
    icon: Mountain,
