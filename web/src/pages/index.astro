const rsaPublicKeyPEM = `-----BEGIN RSA PUBLIC KEY-----
MIIBCgKCAQEAy3W8T9t8ZlXjM4pKl3z8rS5FwX7Pq2NvK8dLt1mF3jB0yG6hJ8aK
c2pLm9xQ7vW3eR1tY5uI7oP9aX2cV4bN6mQ8wE1rT3yU5iO7pA9sD1fG3hJ5kL7z
X9cV2bN4mQ6wE8rT0yU2iO4pA6sD8fG0hJ2kL4zX6cV8bN0mQ2wE4rT6yU8iO0pA
2sD4fG6hJ8kL0zX2cV4bN6mQ8wE0rT2yU4iO6pA8sD0fG2hJ4kL6zX8cV0bN2mQ4
wE6rT8yU0iO2pA4sD6fG8hJ0kL2zX4cV6bN8mQ0wE2rT4yU6iO8pA0sD2fG4hJ6k
L8zX0cV2bN4mQ6wE8rT0yU2iO4pA6sD8fG0hJ2kL4zX6cV8bN0mQ2wE4rT6yU8iO
IDAQAB
-----END RSA PUBLIC KEY-----`;
---

<BaseLayout
  title="Isaac Montoya · Criptografía de Montaña & Portafolio (ESCOM - IPN)"
  description="Página web personal de Isaac Emilio Montoya Rodriguez. Criptografía, perfil académico en ESCOM - IPN, galería, biografía de RSA, CV y prácticas de laboratorio."
>
  <main class="relative min-h-screen snow-cipher-grid text-slate-100">
    <Header />

    <!-- Ambient Glacial Auroras -->
    <div class="glacial-aurora -top-24 left-1/4 h-96 w-96 bg-cyan-500/20" aria-hidden="true"></div>
    <div class="glacial-aurora top-[700px] -right-20 h-[500px] w-[500px] bg-blue-600/15" aria-hidden="true"></div>
    <div class="glacial-aurora top-[1800px] left-10 h-[450px] w-[450px] bg-amber-400/10" aria-hidden="true"></div>

    <!-- ========================================================================= -->
    <!-- 1. HERO / PANTALLA DE PRESENTACIÓN                                        -->
    <!-- ========================================================================= -->
    <section id="hero" class="relative isolate border-b border-cyan-500/15 pt-28 pb-20 md:pt-36 md:pb-28">
      <div class="rosette-watermark absolute inset-0 -z-20 opacity-30"></div>

      <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:px-8 lg:grid-cols-[1.12fr_0.88fr]">
        <!-- Hero Text & Credentials -->
        <div class="space-y-6">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="glass-frost-badge inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-[11px] font-medium tracking-[0.18em] text-cyan-300">
              <Snowflake size={13} className="text-cyan-400" />
              LEOPARDO DE LAS NIEVES · 2026
            </span>
            <span class="glass-rosette-badge inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-[11px] font-medium tracking-[0.16em] text-amber-200">
              <ShieldCheck size={13} className="text-amber-400" />
              ESCOM · IPN
            </span>
          </div>

          <div>
            <p class="font-mono text-xs uppercase tracking-[0.28em] text-cyan-400">
              Criptografía de Montaña · Seguridad & Algoritmos
            </p>
            <h1 class="mt-2 font-crest text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl">
              <span class="text-gradient-ice block">Isaac Emilio</span>
              <span class="text-gradient-cyan block">Montoya Rodriguez</span>
            </h1>
          </div>

          <p class="max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
            Estudiante de <strong class="text-white">Ingeniería en Sistemas Computacionales</strong> en la
            <strong class="text-cyan-200"> Escuela Superior de Cómputo (ESCOM - IPN)</strong>. Explorador de la teoría matemática, la fortaleza de los cifrados asimétricos y la ejecución de algoritmos en entornos web de alta seguridad sin servidor.
          </p>

          <!-- Quick Anchor Chips -->
          <div class="flex flex-wrap items-center gap-2 pt-1 font-mono text-xs">
            <span class="text-[11px] uppercase tracking-wider text-slate-400">Acceso rápido:</span>
            <a href="#formacion" class="rounded-lg border border-cyan-500/20 bg-slate-900/60 px-2.5 py-1 text-slate-300 transition hover:border-cyan-400 hover:text-cyan-200">#Formación</a>
            <a href="#hobbies" class="rounded-lg border border-cyan-500/20 bg-slate-900/60 px-2.5 py-1 text-slate-300 transition hover:border-cyan-400 hover:text-cyan-200">#Hobbies</a>
            <a href="#criptografia" class="rounded-lg border border-cyan-500/20 bg-slate-900/60 px-2.5 py-1 text-slate-300 transition hover:border-cyan-400 hover:text-cyan-200">#HistoriaRSA</a>
            <a href="#crypto-assets" class="rounded-lg border border-cyan-500/20 bg-slate-900/60 px-2.5 py-1 text-slate-300 transition hover:border-cyan-400 hover:text-cyan-200">#Descargas</a>
            <a href="#practicas" class="rounded-lg border border-cyan-500/20 bg-slate-900/60 px-2.5 py-1 text-slate-300 transition hover:border-cyan-400 hover:text-cyan-200">#Prácticas</a>
          </div>

          <!-- Contact Email & Social Buttons -->
          <div class="grid gap-3 pt-2 sm:flex sm:flex-wrap sm:items-center">
            <!-- Copy Email Button -->
            <button
              id="copy-email-btn"
              type="button"
              data-email={studentInfo.email}
              class="glass-frost-card group flex items-center justify-between gap-3 rounded-xl px-4 py-3 text-left transition"
              title="Haz clic para copiar el correo"
            >
              <div class="flex items-center gap-2.5">
                <span class="grid size-8 place-items-center rounded-lg bg-cyan-500/10 text-cyan-400 transition group-hover:bg-cyan-500/20">
                  <Mail size={16} />
                </span>
                <div>
                  <span class="block font-mono text-[10px] uppercase tracking-widest text-slate-400">Contacto Institucional</span>
                  <span class="font-mono text-xs font-semibold text-cyan-200 group-hover:underline">{studentInfo.email}</span>
                </div>
              </div>
              <Copy size={15} className="text-slate-400 transition group-hover:text-cyan-300" />
            </button>

            <!-- Social Links (Inline SVGs for GitHub and LinkedIn) -->
            <div class="flex items-center gap-2.5">
              <a
                href={studentInfo.github}
                target="_blank"
                rel="noreferrer"
                class="glass-frost-card grid size-12 place-items-center rounded-xl text-slate-300 transition hover:border-cyan-300 hover:text-white"
                aria-label="Perfil de GitHub"
                title="GitHub @BigSusFG"
              >
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
              </a>

              <a
                href={studentInfo.linkedin}
                target="_blank"
                rel="noreferrer"
                class="glass-frost-card grid size-12 place-items-center rounded-xl text-slate-300 transition hover:border-cyan-300 hover:text-white"
                aria-label="Perfil de LinkedIn"
                title="LinkedIn"
              >
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>

              <a
                href="#practicas"
                class="inline-flex h-12 items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-5 text-sm font-semibold text-white shadow-[0_0_24px_rgba(56,189,248,0.35)] transition hover:from-cyan-400 hover:to-blue-500 hover:shadow-[0_0_35px_rgba(56,189,248,0.55)]"
              >
                <span>Ver Prácticas</span>
                <ArrowRight size={17} />
              </a>
            </div>
          </div>
        </div>

        <!-- Centerpiece Artwork: Snow Leopard & Mountain Cryptography Emblem -->
        <div class="relative mx-auto w-full max-w-[480px]">
          <div class="glass-frost-card relative overflow-hidden rounded-3xl p-6 md:p-8">
            <!-- Rosette Geometry Rings Backdrop -->
            <div class="absolute -top-12 -right-12 size-48 rounded-full border border-cyan-400/20 bg-cyan-500/5"></div>
            <div class="absolute -bottom-16 -left-16 size-56 rounded-full border border-dashed border-amber-300/20"></div>

            <!-- Header Badge inside Emblem -->
            <div class="relative z-10 flex items-center justify-between border-b border-cyan-500/15 pb-4 font-mono text-[11px]">
              <span class="flex items-center gap-2 text-cyan-300">
                <span class="size-2 rounded-full bg-cyan-400 animate-pulse"></span>
                SELLO CRIPTOGRÁFICO
              </span>
              <span class="text-slate-400">PANTHERA UNCIA // 4096</span>
            </div>

            <!-- Stylized Snow Leopard & Mountain Crest Vector Artwork -->
            <div class="relative my-6 flex aspect-square w-full items-center justify-center">
              <svg viewBox="0 0 320 320" class="size-full max-w-[320px] drop-shadow-[0_0_35px_rgba(56,189,248,0.25)]">
                <defs>
                  <linearGradient id="crestGlacier" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="40%" stop-color="#7dd3fc" />
                    <stop offset="100%" stop-color="#0284c7" />
                  </linearGradient>
                  <radialGradient id="frostHalo" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25" />
                    <stop offset="70%" stop-color="#0284c7" stop-opacity="0.05" />
                    <stop offset="100%" stop-color="transparent" />
                  </radialGradient>
                </defs>

                <!-- Ambient Radial Glow -->
                <circle cx="160" cy="160" r="145" fill="url(#frostHalo)" />

                <!-- Concentric Cryptographic Rings with Dashes -->
                <circle cx="160" cy="160" r="140" fill="none" stroke="#38bdf8" stroke-width="1" stroke-opacity="0.2" />
                <circle cx="160" cy="160" r="126" fill="none" stroke="#fde047" stroke-width="1.2" stroke-dasharray="4 8" stroke-opacity="0.3" />
                <circle cx="160" cy="160" r="110" fill="none" stroke="#38bdf8" stroke-width="1" stroke-dasharray="2 12" stroke-opacity="0.4" />

                <!-- Mountain Summit Polygonal Contours (Karakoram / Himalaya) -->
                <polygon points="160,50 240,210 80,210" fill="none" stroke="url(#crestGlacier)" stroke-width="1.8" stroke-opacity="0.45" />
                <polygon points="160,80 220,210 100,210" fill="none" stroke="#38bdf8" stroke-width="1" stroke-opacity="0.25" />
                <path d="M160,50 L160,210" stroke="#7dd3fc" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="3 3" />

                <!-- Snow Leopard Stylized Geometric Head & Mask -->
                <g transform="translate(160, 160)">
                  <!-- Head Outlines -->
                  <polygon points="0,-48 38,-28 44,14 26,48 -26,48 -44,14 -38,-28" fill="#0b172a" stroke="url(#crestGlacier)" stroke-width="2.2" />
                  <!-- Ears -->
                  <polygon points="-38,-28 -56,-52 -24,-45" fill="#1e293b" stroke="#7dd3fc" stroke-width="1.5" />
                  <polygon points="38,-28 56,-52 24,-45" fill="#1e293b" stroke="#7dd3fc" stroke-width="1.5" />
                  <!-- Forehead Rosette Markings -->
                  <circle cx="0" cy="-26" r="4.5" fill="#fde047" fill-opacity="0.8" />
                  <circle cx="-14" cy="-20" r="3" fill="#38bdf8" fill-opacity="0.8" />
                  <circle cx="14" cy="-20" r="3" fill="#38bdf8" fill-opacity="0.8" />
                  <circle cx="-8" cy="-10" r="2.5" fill="#fde047" fill-opacity="0.7" />
                  <circle cx="8" cy="-10" r="2.5" fill="#fde047" fill-opacity="0.7" />
                  <!-- Piercing Glacial Cyan Eyes -->
                  <polygon points="-22,-2 -10,-2 -16,4" fill="#38bdf8" />
                  <circle cx="-16" cy="0" r="2.2" fill="#ffffff" />
                  <polygon points="22,-2 10,-2 16,4" fill="#38bdf8" />
                  <circle cx="16" cy="0" r="2.2" fill="#ffffff" />
                  <!-- Muzzle & Whisker Polygons -->
                  <polygon points="0,10 -10,24 10,24" fill="#0284c7" stroke="#38bdf8" stroke-width="1" />
                  <path d="M0,24 L0,36 M-8,32 L-24,36 M8,32 L24,36" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />
                  <!-- Cheek Rosettes -->
                  <circle cx="-30" cy="18" r="3" fill="none" stroke="#fde047" stroke-width="1" />
                  <circle cx="30" cy="18" r="3" fill="none" stroke="#fde047" stroke-width="1" />
                </g>

                <!-- Orbiting Hex Coordinates & Rosette Keys -->
                <circle cx="68" cy="110" r="5" fill="#0ea5e9" fill-opacity="0.4" />
                <circle cx="252" cy="110" r="5" fill="#fde047" fill-opacity="0.4" />
                <circle cx="160" cy="270" r="6" fill="#38bdf8" fill-opacity="0.6" />
              </svg>

              <!-- Central Hex Hash Overlay on bottom -->
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 rounded-full border border-cyan-400/30 bg-[#070d18]/90 px-3 py-1 font-mono text-[10px] tracking-[0.2em] text-cyan-300">
                0x7A4F // MODULUS N
              </div>
            </div>

            <!-- Cipher Stream lines -->
            <div class="space-y-1.5 border-t border-cyan-500/15 pt-4 text-center font-mono text-[11px] tracking-[0.26em] text-cyan-200/60">
              {cipherLines.slice(0, 3).map((line) => <p>{line}</p>)}
            </div>

            <div class="mt-4 flex items-center justify-between font-mono text-[10px] text-slate-400">
              <span class="flex items-center gap-1"><KeyRound size={12} className="text-amber-300" /> RSA-4096 BIT</span>
              <span>SHA-256 · TRAPDOOR</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. SECCIÓN: FORMACIÓN ACADÉMICA (ESCOM - IPN)                              -->
    <!-- ========================================================================= -->
    <section id="formacion" class="relative isolate border-b border-cyan-500/15 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="mb-12 max-w-3xl">
          <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.22em] text-cyan-400">
            <GraduationCap size={16} />
            <span>Trayectoria Académica · Formación</span>
          </div>
          <h2 class="mt-3 font-crest text-3xl font-bold tracking-tight text-white sm:text-5xl">
            Escuela Superior de Cómputo <span class="text-gradient-cyan block text-2xl sm:text-4xl">Instituto Politécnico Nacional</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-300">
            Formación integral en ciencias de la computación, arquitectura de software, fundamentos matemáticos y seguridad criptográfica bajo el lema institucional <em class="text-amber-300 font-serif">"La Técnica al Servicio de la Patria"</em>.
          </p>
        </div>

        <!-- Academic Main Card -->
        <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
          <div class="glass-frost-card space-y-6 rounded-2xl p-7 md:p-9">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-cyan-500/15 pb-5">
              <div>
                <span class="font-mono text-xs uppercase tracking-widest text-cyan-400">Programa Académico Oficial</span>
                <h3 class="font-crest text-2xl font-bold text-white">Ingeniería en Sistemas Computacionales</h3>
              </div>
              <span class="rounded-full border border-cyan-400/30 bg-cyan-500/10 px-3.5 py-1 font-mono text-xs font-semibold text-cyan-200">
                7° Semestre
              </span>
            </div>

            <!-- Subject & Professor Spotlight -->
            <div class="rounded-xl border border-cyan-500/20 bg-slate-900/60 p-5">
              <span class="font-mono text-[11px] uppercase tracking-wider text-amber-300">Asignatura Titular</span>
              <h4 class="mt-1 text-lg font-bold text-white">Criptografía</h4>
              <p class="mt-2 text-sm text-slate-300">
                Cátedra impartida por la <strong class="text-cyan-200">M. en C. Nidia A. Cortez Duarte</strong>. Estudio riguroso de cifrados clásicos, criptoanálisis estadístico, teoría de la información de Shannon, estructuras algebraicas de campo finito y esquemas de clave pública como RSA y curvas elípticas.
              </p>
            </div>

            <!-- 4 Competencies Pillars -->
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-cyan-500/15 bg-slate-900/40 p-4">
                <span class="font-mono text-[10px] text-cyan-400">01 / FUNDAMENTOS</span>
                <h5 class="mt-1 font-semibold text-slate-100">Cifrados Clásicos</h5>
                <p class="mt-1 text-xs text-slate-400">César, Vigenère, transposición y criptoanálisis de frecuencia de n-gramas.</p>
              </div>

              <div class="rounded-xl border border-cyan-500/15 bg-slate-900/40 p-4">
                <span class="font-mono text-[10px] text-cyan-400">02 / BYTES & IMÁGENES</span>
                <h5 class="mt-1 font-semibold text-slate-100">Manipulación de Color</h5>
                <p class="mt-1 text-xs text-slate-400">Tratamiento de formatos BMP, canales RGB y operaciones a nivel de byte.</p>
              </div>

