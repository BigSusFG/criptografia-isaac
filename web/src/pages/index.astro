<script>
  // Simple, lightweight Toast Handler for copying email (No RSA scripts)
  const toast = document.getElementById("soft-toast");
  const toastMessage = document.getElementById("toast-message");
  let toastTimer: number | null = null;

  function showToast(message: string) {
    if (!toast || !toastMessage) return;
    toastMessage.textContent = message;
    toast.classList.add("show");

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("show");
    }, 2500);
  }

  const emailBtn = document.getElementById("copy-email-btn");
  if (emailBtn) {
    emailBtn.addEventListener("click", async () => {
      const email = emailBtn.getAttribute("data-email") || "emontoyar1400@alumno.ipn.mx";
      try {
        await navigator.clipboard.writeText(email);
        showToast("Correo institucional copiado con éxito");
      } catch {
        showToast(`Correo: ${email}`);
      }
    });
  }
</script>
