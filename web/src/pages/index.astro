<script>
  // Toast Notification Handler
  const toast = document.getElementById("frost-toast");
  const toastMessage = document.getElementById("toast-message");
  let toastTimer: number | null = null;

  function showToast(message: string) {
    if (!toast || !toastMessage) return;
    toastMessage.textContent = message;
    toast.classList.add("show");

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("show");
    }, 2800);
  }

  // Copy Email Handler
  const emailBtn = document.getElementById("copy-email-btn");
  if (emailBtn) {
    emailBtn.addEventListener("click", async () => {
      const email = emailBtn.getAttribute("data-email") || "emontoyar1400@alumno.ipn.mx";
      try {
        await navigator.clipboard.writeText(email);
        showToast("Correo institucional copiado con éxito");
      } catch (err) {
        showToast(`Correo: ${email}`);
      }
    });
  }

  // Copy RSA Key Handlers
  const copyKeyBtn = document.getElementById("copy-key-btn");
  const copyKeySecondaryBtn = document.getElementById("copy-key-secondary-btn");

  const handleCopyKey = async (btn: HTMLElement | null) => {
    if (!btn) return;
    const key = btn.getAttribute("data-key");
    if (!key) return;
    try {
      await navigator.clipboard.writeText(key);
      showToast("Llave Pública RSA copiada al portapapeles");
    } catch (err) {
      showToast("Llave lista para descargar en .pub");
    }
  };

  if (copyKeyBtn) copyKeyBtn.addEventListener("click", () => handleCopyKey(copyKeyBtn));
  if (copyKeySecondaryBtn) copyKeySecondaryBtn.addEventListener("click", () => handleCopyKey(copyKeySecondaryBtn));
</script>
