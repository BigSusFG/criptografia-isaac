---
import {
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Check,
  CheckCircle2,
  CircleDot,
  Compass,
  Copy,
  Download,
  ExternalLink,
  FileText,
  GraduationCap,
  KeyRound,
  LockKeyhole,
  Mail,
  ShieldCheck,
  Sparkles,
  Terminal,
} from "lucide-react";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const studentInfo = {
  fullName: "Isaac Emilio Montoya Rodriguez",
  shortName: "Isaac Montoya",
  title: "Estudiante de Ingeniería en Sistemas Computacionales",
  school: "Escuela Superior de Cómputo (ESCOM)",
  institution: "Instituto Politécnico Nacional (IPN)",
  course: "Criptografía",
  professor: "M. en C. Nidia A. Cortez Duarte",
  semester: "7° Semestre · Ciclo 2026",
  email: "emontoyar1400@alumno.ipn.mx",
  github: "https://github.com/BigSusFG",
  linkedin: "https://www.linkedin.com/in/isaac-montoya-rodriguez",
};

const hobbies = [
  {
    id: "mountain",
    title: "Senderismo & Cumbres",
    category: "Exploración & Altura",
    badge: "Naturaleza",
    pillClass: "pill-soft-peach",
    description:
      "Exploración de crestas y senderos de alta montaña. Enseña paciencia estratégica, resistencia ante terrenos desafiantes y perspectiva panorámica del entorno.",
    quote: "La constancia en la subida revela la belleza de la cima.",
    accentColor: "#fb923c",
    svgType: "mountain",
  },
  {
    id: "chess",
    title: "Ajedrez Táctico & Lógica",
    category: "Pensamiento Estratégico",
    badge: "Mente",
    pillClass: "pill-soft-lavender",
    description:
      "Un universo cerrado de 64 casillas donde cada apertura y defensa es análoga a un protocolo formal: cálculo de variantes, reducción de entropía y anticipación.",
    quote: "Cada jugada es una hipótesis matemática puesta a prueba.",
    accentColor: "#c084fc",
    svgType: "chess",
  },
  {
    id: "music",
    title: "Piano & Acústica Armónica",
    category: "Sensibilidad & Proporción",
    badge: "Música",
    pillClass: "pill-soft-rose",
    description:
      "Interpretación acústica y estudio de relaciones numéricas sonoras: intervalos logarítmicos, resonancias periódicas y descomposición armónica en el tiempo.",
    quote: "La música es el cálculo sensible del alma.",
    accentColor: "#f472b6",
    svgType: "music",
  },
  {
    id: "systems",
    title: "Arquitectura Web & WASM",
    category: "Cómputo en Cliente",
    badge: "Sistemas",
    pillClass: "pill-soft-mint",
    description:
      "Diseño de software seguro directamente en el navegador mediante Pyodide y WebAssembly, procesando datos localmente sin exponerlos a servidores ajenos.",
    quote: "Privacidad por diseño y soberanía computacional.",
    accentColor: "#4ade80",
    svgType: "systems",
  },
];
---

<BaseLayout
  title="Isaac Montoya · Portafolio & Criptografía (ESCOM - IPN)"
  description="Página personal estilo Bento Grid de Isaac Emilio Montoya Rodriguez. Formación en ESCOM - IPN, Hobbies, Historia de Criptografía, CV y Prácticas."
>
  <main class="relative min-h-screen bento-ambient-bg text-stone-800">
    <Header />

    <!-- Soft Ambient Glow Blobs -->
    <div class="soft-glow-blob -top-20 left-10 size-96 bg-rose-200/50" aria-hidden="true"></div>
    <div class="soft-glow-blob top-[600px] -right-20 size-[500px] bg-amber-200/40" aria-hidden="true"></div>
    <div class="soft-glow-blob top-[1500px] left-1/3 size-[450px] bg-purple-200/40" aria-hidden="true"></div>
    <div class="soft-glow-blob top-[2600px] right-10 size-[500px] bg-sky-200/40" aria-hidden="true"></div>

    <div class="mx-auto max-w-7xl px-5 py-8 md:px-8 md:py-14 space-y-16">
      <!-- ======================================================================= -->
      <!-- 1. BENTO PRESENTACIÓN / HERO                                            -->
      <!-- ======================================================================= -->
      <section id="hero" class="relative">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <!-- CARD A: Main Profile Card (Big Bento Hero) -->
          <div class="bento-card col-span-12 p-8 md:p-12 lg:col-span-8 flex flex-col justify-between">
            <div>
              <!-- Cute Status Pill -->
              <div class="flex flex-wrap items-center gap-2 mb-6">
                <span class="pill-soft-rose inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-xs font-medium shadow-sm">
                  <Sparkles size={13} className="text-pink-600" />
                  Portafolio & Criptografía 2026
                </span>
                <span class="pill-soft-lavender inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-xs font-medium shadow-sm">
                  <GraduationCap size={13} className="text-purple-600" />
                  ESCOM · IPN
                </span>
              </div>

              <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-6">
                <div class="space-y-3">
                  <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-pink-600">
                    Hola, bienvenido a mi espacio
                  </p>
                  <h1 class="text-3xl font-extrabold tracking-tight text-stone-900 sm:text-5xl lg:text-6xl font-display">
                    {studentInfo.fullName}
                  </h1>
                  <p class="text-base font-medium text-stone-600 sm:text-lg">
                    Estudiante de <strong class="text-stone-900 font-semibold">Ingeniería en Sistemas Computacionales</strong> en la
                    <strong class="text-pink-700 font-semibold"> Escuela Superior de Cómputo (ESCOM - IPN)</strong>.
                  </p>
                </div>

                <!-- Stylized Profile Avatar Frame -->
                <div class="relative shrink-0 self-center sm:self-auto">
                  <div class="relative grid size-28 sm:size-32 place-items-center rounded-3xl bg-gradient-to-tr from-rose-200 via-pink-100 to-purple-200 p-1 shadow-lg shadow-pink-200/50">
                    <div class="grid size-full place-items-center rounded-[1.35rem] bg-white/90 p-2 backdrop-blur-md">
                      <!-- Stylized Cute Vector Portrait / Avatar Icon -->
                      <svg class="size-full text-stone-800" viewBox="0 0 100 100" fill="none">
                        <circle cx="50" cy="50" r="46" fill="#fdf2f8" stroke="#f472b6" stroke-width="1.5" stroke-dasharray="3 3" />
                        <!-- Head -->
                        <circle cx="50" cy="40" r="18" fill="#fed7aa" />
                        <!-- Hair -->
                        <path d="M32 38 C32 24 68 24 68 38 C68 30 60 22 50 22 C40 22 32 30 32 38 Z" fill="#44403c" />
                        <!-- Glasses -->
                        <circle cx="43" cy="41" r="5" stroke="#1c1917" stroke-width="2" fill="none" />
                        <circle cx="57" cy="41" r="5" stroke="#1c1917" stroke-width="2" fill="none" />
                        <path d="M48 41 L52 41" stroke="#1c1917" stroke-width="2" />
                        <!-- Smile -->
                        <path d="M45 49 Q50 54 55 49" stroke="#9a3412" stroke-width="1.8" stroke-linecap="round" fill="none" />
                        <!-- Cheeks blush -->
                        <circle cx="39" cy="45" r="2.5" fill="#f43f5e" opacity="0.4" />
                        <circle cx="61" cy="45" r="2.5" fill="#f43f5e" opacity="0.4" />
                        <!-- Shoulders / Hoodie -->
                        <path d="M26 82 C26 64 74 64 74 82 Z" fill="#9333ea" opacity="0.85" />
                        <path d="M38 82 L44 68 L50 78 L56 68 L62 82 Z" fill="#e9d5ff" />
                        <!-- Key sparkle badge -->
                        <circle cx="76" cy="74" r="10" fill="#fef08a" stroke="#eab308" stroke-width="1.5" />
                        <path d="M74 74 L78 74 M76 72 L76 76" stroke="#854d0e" stroke-width="1.5" stroke-linecap="round" />
                      </svg>
                    </div>
                    <!-- Cute floating pin -->
                    <span class="absolute -top-1.5 -right-1.5 flex size-6 items-center justify-center rounded-full bg-pink-500 text-white shadow-md text-[10px]">
                      ✨
                    </span>
                  </div>
                </div>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-stone-600 max-w-2xl">
                Explorador de algoritmos criptográficos, teoría de números, cifrados simétricos y asimétricos, y desarrollo de aplicaciones web ejecutadas en el navegador mediante WebAssembly sin comprometer datos personales.
              </p>
            </div>

            <!-- Contact & Social Action Bar -->
            <div class="mt-8 pt-6 border-t border-stone-200/60 flex flex-wrap items-center justify-between gap-4">
              <!-- Copy Email Interactive Button -->
              <button
                id="copy-email-btn"
                type="button"
                data-email={studentInfo.email}
                class="group flex items-center gap-2.5 rounded-2xl bg-white px-4 py-2.5 shadow-sm border border-stone-200/70 hover:border-pink-300 hover:shadow-md transition text-left"
                title="Haz clic para copiar el correo institucional"
              >
                <div class="grid size-8 place-items-center rounded-xl bg-pink-50 text-pink-600 group-hover:bg-pink-100 transition">
                  <Mail size={16} />
                </div>
                <div>
                  <span class="block text-[10px] font-mono uppercase tracking-wider text-stone-400">Correo Institucional</span>
                  <span class="block text-xs font-semibold text-stone-800 group-hover:text-pink-600 transition">{studentInfo.email}</span>
                </div>
                <Copy size={14} className="text-stone-400 ml-2 group-hover:text-pink-500 transition" />
              </button>

              <!-- Social Network Buttons -->
              <div class="flex items-center gap-2">
                <!-- GitHub -->
                <a
                  href={studentInfo.github}
                  target="_blank"
                  rel="noreferrer"
                  class="flex items-center gap-2 rounded-2xl bg-white px-3.5 py-2.5 shadow-sm border border-stone-200/70 hover:border-stone-400 hover:shadow-md transition text-stone-700"
                  title="Ver GitHub"
                >
                  <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                  </svg>
                  <span class="text-xs font-semibold">GitHub</span>
                </a>

                <!-- LinkedIn -->
                <a
                  href={studentInfo.linkedin}
                  target="_blank"
                  rel="noreferrer"
                  class="flex items-center gap-2 rounded-2xl bg-white px-3.5 py-2.5 shadow-sm border border-stone-200/70 hover:border-blue-400 hover:shadow-md transition text-[#0a66c2]"
                  title="Ver LinkedIn"
                >
                  <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                  <span class="text-xs font-semibold">LinkedIn</span>
                </a>

                <!-- Quick Button to Practices -->
                <a
                  href="#practicas"
                  class="flex items-center gap-1.5 rounded-2xl bg-gradient-to-r from-pink-500 to-rose-500 px-4 py-2.5 text-xs font-semibold text-white shadow-md shadow-pink-200/60 hover:from-pink-600 hover:to-rose-600 transition"
                >
                  <span>Ver Prácticas</span>
                  <ArrowRight size={14} />
                </a>
              </div>
            </div>
          </div>

          <!-- CARD B: Academic Mini Bento Highlights (col-span-12 lg:col-span-4 flex flex-col gap-6) -->
          <div class="col-span-12 lg:col-span-4 flex flex-col gap-6">
            <!-- Subcard 1: ESCOM Institution Snapshot -->
            <div class="bento-card p-6 flex flex-col justify-between flex-1">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div class="grid size-10 place-items-center rounded-2xl bg-purple-100 text-purple-700">
                    <GraduationCap size={20} />
                  </div>
                  <span class="pill-soft-mint text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                    Alumno Activo
                  </span>
                </div>
                <h3 class="text-lg font-bold text-stone-900 font-display">
                  Escuela Superior de Cómputo
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Instituto Politécnico Nacional (IPN). 7° Semestre de Ingeniería en Sistemas Computacionales en Ciudad de México.
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-stone-200/60 flex items-center justify-between text-[11px] text-stone-500 font-mono">
                <span>Cátedra de Criptografía</span>
                <span class="text-pink-600 font-medium">Ciclo 2026</span>
              </div>
            </div>

            <!-- Subcard 2: Client-side Crypto WASM Pill -->
            <div class="bento-card p-6 flex flex-col justify-between flex-1 bg-gradient-to-br from-white/90 via-pink-50/40 to-purple-50/50">
              <div class="space-y-2">
                <div class="flex items-center gap-2 text-pink-600">
                  <Terminal size={18} />
                  <span class="font-mono text-[11px] uppercase tracking-wider font-semibold">Tecnología Central</span>
                </div>
                <h4 class="text-base font-bold text-stone-900">Python en el Navegador</h4>
                <p class="text-xs text-stone-600">
                  Cálculo de algoritmos con Pyodide (WebAssembly), garantizando cero telemetría y privacidad total.
                </p>
              </div>

              <div class="mt-4 flex flex-wrap gap-1.5 pt-2">
                <span class="pill-soft-peach px-2 py-0.5 rounded-lg text-[10px] font-mono">Python 3.12</span>
                <span class="pill-soft-sky px-2 py-0.5 rounded-lg text-[10px] font-mono">Pyodide WASM</span>
                <span class="pill-soft-rose px-2 py-0.5 rounded-lg text-[10px] font-mono">Astro v5</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ======================================================================= -->
      <!-- 2. BENTO FORMACIÓN ACADÉMICA                                            -->
      <!-- ======================================================================= -->
      <section id="formacion" class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <div>
            <span class="pill-soft-lavender inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium">
              <GraduationCap size={13} className="text-purple-600" />
              01 · Trayectoria Oficial
            </span>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900 sm:text-4xl font-display">
              Formación Académica
            </h2>
          </div>
          <p class="max-w-md text-xs sm:text-sm text-stone-500">
            Formación integral en ciencias de la computación, arquitectura de sistemas y seguridad bajo el lema politécnico: <em class="text-stone-700">"La Técnica al Servicio de la Patria"</em>.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <!-- Big Academic Detail Card -->
          <div class="bento-card col-span-12 lg:col-span-7 p-7 md:p-9 space-y-6 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-4">
                <div>
                  <span class="font-mono text-[10px] uppercase tracking-wider text-pink-600 font-semibold">Carrera Universitaria</span>
                  <h3 class="text-xl font-bold text-stone-900 sm:text-2xl font-display">
                    Ingeniería en Sistemas Computacionales
                  </h3>
                </div>
                <span class="pill-soft-peach px-3 py-1 rounded-full text-xs font-semibold">
                  7° Semestre
                </span>
              </div>

              <!-- Professor Spotlight -->
              <div class="bento-subcard p-5 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[11px] font-semibold text-purple-700 uppercase tracking-wider">Materia Titular</span>
                  <span class="pill-soft-rose text-[10px] font-medium px-2 py-0.5 rounded-full">Semestre 2026</span>
                </div>
                <h4 class="text-base font-bold text-stone-900">Criptografía</h4>
                <p class="text-xs leading-relaxed text-stone-600">
                  Cátedra impartida por la profesora <strong class="text-stone-800">M. en C. Nidia A. Cortez Duarte</strong>. Estudio riguroso de cifrados clásicos, criptoanálisis estadístico de frecuencias, manipulación de mapas de bits, aritmética modular y criptografía de clave pública.
                </p>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 pt-2">
              <div class="bento-subcard p-3.5">
                <span class="font-mono text-[10px] text-pink-600 font-semibold">01 / FUNDAMENTOS</span>
                <h5 class="text-xs font-bold text-stone-800 mt-0.5">Cifrados Clásicos</h5>
                <p class="text-[11px] text-stone-500 mt-1">César, Vigenère y transposición.</p>
              </div>
              <div class="bento-subcard p-3.5">
                <span class="font-mono text-[10px] text-purple-600 font-semibold">02 / BYTES & COLOR</span>
                <h5 class="text-xs font-bold text-stone-800 mt-0.5">Manipulación BMP</h5>
                <p class="text-[11px] text-stone-500 mt-1">Desplazamiento modular RGB 256.</p>
              </div>
              <div class="bento-subcard p-3.5">
                <span class="font-mono text-[10px] text-amber-600 font-semibold">03 / ASIMÉTRICO</span>
                <h5 class="text-xs font-bold text-stone-800 mt-0.5">RSA & Primalidad</h5>
                <p class="text-[11px] text-stone-500 mt-1">Teoría de números y trampas modulares.</p>
              </div>
              <div class="bento-subcard p-3.5">
                <span class="font-mono text-[10px] text-emerald-600 font-semibold">04 / ENTORNO</span>
                <h5 class="text-xs font-bold text-stone-800 mt-0.5">Pyodide WASM</h5>
                <p class="text-[11px] text-stone-500 mt-1">Ejecución estática en cliente.</p>
              </div>
            </div>
          </div>

          <!-- Academic Highlights & Quick CV Access -->
          <div class="col-span-12 lg:col-span-5 flex flex-col gap-6">
            <div class="bento-card p-6 md:p-8 space-y-4 flex-1">
              <div class="flex items-center gap-3">
                <div class="grid size-10 place-items-center rounded-2xl bg-amber-100 text-amber-700">
                  <ShieldCheck size={20} />
                </div>
                <div>
                  <h4 class="text-base font-bold text-stone-900 font-display">Identidad Politécnica</h4>
                  <p class="text-xs text-stone-500">ESCOM Zacatenco · Ciudad de México</p>
                </div>
              </div>

              <p class="text-xs leading-relaxed text-stone-600">
                La Escuela Superior de Cómputo es referente en formación tecnológica e ingeniería de software de alto impacto en México.
              </p>

              <div class="space-y-2 pt-2 border-t border-stone-200/60 font-mono text-xs text-stone-600">
                <div class="flex justify-between"><span>Unidad Académica:</span> <strong class="text-stone-800">ESCOM - IPN</strong></div>
                <div class="flex justify-between"><span>Modalidad:</span> <span class="text-stone-700">Presencial & Laboratorio</span></div>
                <div class="flex justify-between"><span>Estado Curricular:</span> <span class="text-emerald-700 font-semibold">Regular / En curso</span></div>
              </div>
            </div>

            <!-- Soft CV Callout -->
            <div class="bento-card p-6 bg-gradient-to-br from-rose-50/80 via-white/80 to-purple-50/80 flex items-center justify-between gap-4">
              <div>
                <span class="font-mono text-[10px] uppercase tracking-wider text-pink-600 font-semibold">Expediente Oficial</span>
                <h4 class="text-sm font-bold text-stone-900">Curriculum Vitae (PDF)</h4>
                <p class="text-xs text-stone-500">Documento listo para descargar.</p>
              </div>
              <a
                href={`${base}cv.pdf`}
                download="CV_Isaac_Montoya_ESCOM.pdf"
                class="shrink-0 inline-flex items-center gap-1.5 rounded-xl bg-pink-500 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-pink-600 transition"
              >
                <Download size={13} />
                <span>Bajar CV</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ======================================================================= -->
      <!-- 3. BENTO HOBBIES & GALERÍA VISUAL (4 ÍTEMS ESTILIZADOS)                 -->
      <!-- ======================================================================= -->
      <section id="hobbies" class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <div>
            <span class="pill-soft-peach inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium">
              <Compass size={13} className="text-orange-600" />
              02 · Galería Visual & Pasiones
            </span>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900 sm:text-4xl font-display">
              Hobbies & Galería
            </h2>
          </div>
          <p class="max-w-md text-xs sm:text-sm text-stone-500">
            Disciplinas que complementan el pensamiento estructurado: naturaleza, estrategia abstracta, acústica y desarrollo libre.
          </p>
        </div>

        <!-- 4-Card Bento Visual Grid -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {hobbies.map((item, index) => (
            <article class="bento-card p-5 flex flex-col justify-between group">
              <div>
                <!-- Pastel Visual Artwork Banner -->
                <div class="relative mb-4 flex h-36 w-full items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-b from-stone-50 to-stone-100 border border-stone-200/50">
                  {item.svgType === "mountain" && (
                    <svg class="size-full p-3 transition duration-500 group-hover:scale-105" viewBox="0 0 200 120" fill="none">
                      <!-- Soft mountains -->
