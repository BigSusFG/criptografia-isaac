---
import { ArrowLeft, CheckCircle2, FileCode2, Info } from "lucide-react";
import Header from "../../components/Header.astro";
import PracticeOneDemo from "../../components/practices/PracticeOneDemo";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pythonSource = `def filas_circulo_relleno(ancho, alto, radio):
    centro_x, centro_y = ancho // 2, alto // 2
    x, y, decision = 0, radio, 1 - radio
    filas = {}

    while x <= y:
        registrar_fila(filas, centro_y + y, centro_x - x, centro_x + x)
        registrar_fila(filas, centro_y - y, centro_x - x, centro_x + x)
        registrar_fila(filas, centro_y + x, centro_x - y, centro_x + y)
        registrar_fila(filas, centro_y - x, centro_x - y, centro_x + y)
        x += 1
        if decision < 0:
            decision += 2 * x + 1
        else:
            y -= 1
            decision += 2 * (x - y) + 1

    return filas

def desplazar_color(color, desplazamiento):
    return tuple((canal + desplazamiento) % 256 for canal in color)`;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<BaseLayout title="Práctica 01 · Criptografía">
  <main class="min-h-screen bg-[#0a0908] text-[#f7f3ed]">
    <Header />
    <section class="relative overflow-hidden border-b border-orange-100/10 px-5 pb-14 pt-32 md:px-8 md:pb-20">
      <div class="cipher-grid absolute inset-0 opacity-25"></div>
      <div class="relative mx-auto max-w-7xl">
        <a href={`${base}#practicas`} class="mb-12 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-stone-500 transition hover:text-orange-300"><ArrowLeft size={16} /> Volver al archivo</a>
        <div class="grid gap-9 lg:grid-cols-[0.24fr_1fr] lg:items-end">
          <div class="font-mono text-[clamp(5rem,14vw,11rem)] font-light leading-none tracking-[-0.1em] text-orange-400">01</div>
          <div><div class="mb-5 flex flex-wrap gap-2"><span class="rounded-full border border-orange-300/25 bg-orange-300/10 px-2.5 py-1 text-xs text-orange-200">Python</span><span class="rounded-full border border-orange-100/15 px-2.5 py-1 text-xs text-stone-300">BMP 24 bits</span><span class="rounded-full border border-orange-100/15 px-2.5 py-1 text-xs text-stone-300">RGB módulo 256</span></div><h1 class="max-w-5xl text-balance text-4xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-6xl lg:text-7xl">Círculo relleno y desplazamiento de imágenes</h1><p class="mt-6 max-w-3xl text-base leading-7 text-stone-500">Genera una imagen BMP con un círculo relleno o carga una imagen propia para desplazar cada uno de sus píxeles RGB.</p></div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-14 md:px-8 md:py-20">
      <PracticeOneDemo client:load />
      <div class="mt-6 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
        <article class="overflow-hidden rounded-[1.5rem] border border-orange-100/10 bg-[#100d0a]"><div class="flex items-center justify-between border-b border-orange-100/10 px-5 py-4"><div class="flex items-center gap-2 text-sm text-stone-300"><FileCode2 className="text-orange-400" size={16} /><span class="font-mono text-xs">python/practica_01.py</span></div><span class="font-mono text-[10px] uppercase tracking-widest text-stone-700">Núcleo del algoritmo</span></div><pre class="overflow-x-auto p-5 text-sm leading-7 text-stone-300 sm:p-7"><code>{pythonSource}</code></pre></article>
        <aside class="rounded-[1.5rem] border border-orange-100/10 bg-orange-300/[0.025] p-6 sm:p-8"><p class="font-mono text-[10px] uppercase tracking-[0.2em] text-orange-400">Proceso</p><ul class="mt-7 space-y-5">{["Construye manualmente la cabecera BMP de 24 bits.", "Calcula el borde por punto medio y rellena tramos horizontales.", "Acepta PNG, JPG, WebP, BMP y otros formatos del navegador.", "Aplica (canal + desplazamiento) mod 256 píxel por píxel."].map((item) => <li class="flex gap-3 text-sm leading-6 text-stone-500"><CheckCircle2 className="mt-0.5 shrink-0 text-orange-400" size={16} />{item}</li>)}</ul><div class="mt-7 flex gap-3 border-t border-orange-100/10 pt-6 text-xs leading-5 text-stone-600"><Info className="mt-0.5 shrink-0 text-orange-400" size={16} />Las imágenes cargadas conservan transparencia y se descargan como PNG.</div></aside>
      </div>
    </section>
  </main>
</BaseLayout>
