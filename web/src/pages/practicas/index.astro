---
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
const b = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const entries=[{id:'00',title:'Fundamentos de cifrado',desc:'Una introducción interactiva a los mecanismos de cifrado.',tag:'Introducción',href:'00/'},{id:'01',title:'Un corazón en BMP',desc:'Crea, cifra y recupera los colores de una imagen con desplazamientos RGB.',tag:'Imágenes + Python',href:'01/'},{id:'02',title:'Mensajes secretos',desc:'Alicia y Betito intercambian archivos de texto con el cifrado César.',tag:'Texto + Python',href:'02/'}];
---
<BaseLayout title="Prácticas — Isaac Montoya Rodríguez" description="Laboratorio interactivo de criptografía de Isaac Montoya Rodríguez."><div class="im-site"><Header/><main class="im-practices im-wrap"><a href={b} class="im-back">← Regresar a mi blog</a><p class="im-section-index">MI LABORATORIO PERSONAL</p><h1>Pequeños experimentos,<br/><em>grandes preguntas.</em></h1><p class="im-practice-intro">Aquí viven las prácticas de criptografía de la ESCOM. Puedes abrir cada experimento, ver cómo funciona y probarlo tú mismo.</p><div class="im-practice-grid">{entries.map(e=><a class="im-practice-entry" href={`${b}practicas/${e.href}`}><div class="im-practice-entry-head"><span>{e.tag}</span><span>↗</span></div><strong>{e.id}</strong><h2>{e.title}</h2><p>{e.desc}</p><span class="im-practice-go">Abrir práctica →</span></a>)}</div></main><footer class="im-footer"><div class="im-wrap"><span>✳ Isaac Montoya Rodríguez</span><a href={b}>Volver al blog ↗</a></div></footer></div></BaseLayout>
