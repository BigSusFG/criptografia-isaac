---
import { ArrowLeft, CheckCircle2, FileCode2, Info } from "lucide-react";
import Header from "../../components/Header.astro";
import PracticeZeroDemo from "../../components/practices/PracticeZeroDemo";
import BaseLayout from "../../layouts/BaseLayout.astro";
import pythonSource from "../../python/practica_00.py?raw";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<BaseLayout title="Práctica 00 · Criptografía">
  <main class="min-h-screen bento-ambient-bg text-stone-800">
    <Header />
    <section class="relative overflow-hidden border-b border-stone-200/60 px-5 pb-14 pt-28 md:px-8 md:pb-20">
      <div class="relative mx-auto max-w-7xl">
        <a href={`${base}practicas/`} class="mb-10 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-stone-500 transition hover:text-pink-600"><ArrowLeft size={16} /> Volver a prácticas</a>
        <div class="grid gap-9 lg:grid-cols-[0.24fr_1fr] lg:items-end">
          <div class="font-mono text-[clamp(5rem,14vw,11rem)] font-light leading-none tracking-[-0.1em] text-pink-500">00</div>
          <div>
            <div class="mb-4 flex flex-wrap gap-2">
              <span class="pill-soft-peach px-2.5 py-1 text-xs font-semibold rounded-full">Python</span>
              <span class="pill-soft-lavender px-2.5 py-1 text-xs font-semibold rounded-full">Pyodide</span>
              <span class="pill-soft-mint px-2.5 py-1 text-xs font-semibold rounded-full">Prueba técnica</span>
            </div>
            <h1 class="max-w-4xl text-balance text-4xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-6xl lg:text-7xl text-stone-900 font-display">Python dentro del navegador</h1>
            <p class="mt-4 max-w-2xl text-base leading-7 text-stone-600">La interfaz envía texto a Python, ejecuta una función con Pyodide y recupera el resultado sin levantar un servidor.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-14 md:px-8 md:py-20">
      <PracticeZeroDemo client:load />
      <div class="mt-8 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
        <article class="bento-card overflow-hidden p-6 sm:p-8">
          <div class="flex items-center justify-between border-b border-stone-200/60 pb-4">
            <div class="flex items-center gap-2 text-sm text-stone-800">
              <FileCode2 className="text-pink-600" size={16} />
              <span class="font-mono text-xs font-semibold">web/src/python/practica_00.py</span>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-widest text-stone-400">Código Fuente</span>
          </div>
          <pre class="mt-4 overflow-x-auto rounded-2xl bg-stone-900 p-5 text-sm leading-6 text-stone-200 font-mono"><code>{pythonSource}</code></pre>
        </article>

        <aside class="bento-card p-6 sm:p-8 space-y-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-pink-600 font-semibold">Qué valida</p>
          <ul class="space-y-4">
            {["La interfaz carga el intérprete de Python.", "El texto se entrega como una variable segura.", "Python procesa y devuelve el resultado.", "La base queda lista para algoritmos criptográficos."].map((item) => (
              <li class="flex gap-3 text-sm leading-6 text-stone-600">
                <CheckCircle2 className="mt-0.5 shrink-0 text-emerald-600" size={16} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="flex gap-3 border-t border-stone-200/60 pt-5 text-xs leading-5 text-stone-500">
            <Info className="mt-0.5 shrink-0 text-pink-600" size={16} />
            <span>Invertir texto solo prueba la integración; no se presenta como un método de cifrado.</span>
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
