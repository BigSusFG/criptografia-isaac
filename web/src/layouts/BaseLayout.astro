---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Isaac Montoya · Criptografía & Ciberseguridad (ESCOM - IPN)",
  description = "Portafolio y página personal de Isaac Emilio Montoya Rodriguez. Criptografía, prácticas de laboratorio en WebAssembly y desarrollo de sistemas en ESCOM - IPN.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Isaac Emilio Montoya Rodriguez" />
    <meta name="keywords" content="Criptografía, ESCOM, IPN, Isaac Montoya, RSA, Pyodide, Python, Algoritmos, Seguridad Informática" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts: Cinzel (Crest), Plus Jakarta Sans (Modern UI), JetBrains Mono (Code/Crypto) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23070d18'/%3E%3Cpath d='M16 4 L28 10 L28 22 L16 28 L4 22 L4 10 Z' fill='none' stroke='%2338bdf8' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='4' fill='%23fde047'/%3E%3C/svg%3E" />

    <title>{title}</title>
  </head>
  <body class="bg-[#070d18] text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-white">
    <slot />
  </body>
</html>
