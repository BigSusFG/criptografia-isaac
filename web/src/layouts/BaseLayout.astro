---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Criptografía · Isaac Montoya Rodríguez",
  description = "Portafolio académico de prácticas de criptografía implementadas con Python.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
